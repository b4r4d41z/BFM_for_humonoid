+def test_missing_topics_and_held_command_checks(source):
+    records, meta = copy.deepcopy(source)
+    records.pop(TOPICS[0])
+    with pytest.raises(ValueError, match='Missing required topic'): make((records,meta))
+    records, meta = copy.deepcopy(source)
