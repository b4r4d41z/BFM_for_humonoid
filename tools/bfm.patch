index 0000000000000000000000000000000000000000..7260a062d5d302cd24ba100d274cceef23b10ade
--- /dev/null
+++ b/bfm/data/recorder.py
@@ -0,0 +1,53 @@
+"""Reference single-environment recorder for measured policy-rate transitions."""
+import numpy as np
+import torch
+
+from bfm.contracts.kuavo import STATE_FIELDS
+from .schema import episode_metadata
+from .zarr_io import write_episode
+
+
+def cpu_state(state):
+    result = {}
+    for k, v in state.items():
+        a = torch.as_tensor(v).detach().cpu().numpy()
+        if a.ndim != 2 or a.shape[0] != 1:
+            raise ValueError("Reference recorder requires exactly one environment")
+        result[k] = a[0].copy()
+    return result
+
+
+class BFMRecorder:
+    def __init__(self, contract, *, episode_id, split, provenance, initial_scene, joint_names):
+        self.contract = contract
+        self.metadata = episode_metadata(contract, episode_id=episode_id, split=split, provenance=provenance, initial_scene=initial_scene)
+        self.metadata["all_joint_names"] = list(joint_names)
+        self.transitions = []
+        self.next_step = 0
+
+    def append(self, state, physical_action, isaac_action, next_state, *, terminated, truncated, control_steps):
+        if self.transitions and (self.transitions[-1]["terminated"] or self.transitions[-1]["truncated"]):
+            raise ValueError("Episode already ended; create a new recorder after reset")
+        s, ns = cpu_state(state), cpu_state(next_state)
+        if set(s) != set(ns):
+            raise ValueError("Measured observation fields changed within a transition")
+        for k, v in s.items():
+            if k not in STATE_FIELDS:
+                if k not in ("all_joint_q", "all_joint_dq") or len(v) != len(self.metadata["all_joint_names"]):
+                    raise ValueError(f"Unsupported rich measured field: {k}")
+                self.metadata["state_fields"][k] = {"width": len(v), "unit": "rad" if k.endswith('_q') else "rad/s"}
+        row = {f"{prefix}/{k}": v for prefix, values in (("obs", s), ("next_obs", ns)) for k, v in values.items()}
+        row.update(action=torch.as_tensor(physical_action).detach().cpu().numpy().reshape(-1),
+                   isaac_action=torch.as_tensor(isaac_action).detach().cpu().numpy().reshape(-1),
+                   terminated=bool(terminated), truncated=bool(truncated),
+                   step_index=self.next_step, next_step_index=self.next_step + control_steps,
+                   timestamp=self.next_step * self.contract.control_dt,
+                   next_timestamp=(self.next_step + control_steps) * self.contract.control_dt)
+        self.transitions.append(row)
+        self.next_step += control_steps
+
+    def save(self, path):
+        if not self.transitions:
+            raise ValueError("No measured transitions recorded")
+        arrays = {k: np.stack([row[k] for row in self.transitions]) for k in self.transitions[0]}
+        return write_episode(path, arrays, self.metadata)
diff --git a/bfm/data/replay_buffer.py b/bfm/data/replay_buffer.py
new file mode 100644
index 0000000000000000000000000000000000000000..e18f1613554879f7ff4a88a42fcdcc67a28bf213
--- /dev/null
+++ b/bfm/data/replay_buffer.py
@@ -0,0 +1,56 @@
+import copy
+import numpy as np
+import torch
+
+
+class BFMReplayBuffer:
+    def __init__(self, episodes, seed=0):
+        if not episodes:
+            raise ValueError("Replay needs at least one episode")
+        for e in episodes:
+            n = len(e["observation"])
+            term, trunc = torch.as_tensor(e["terminated"]), torch.as_tensor(e["truncated"])
+            if n == 0 or any(len(v) != n for v in e.values()):
+                raise ValueError("Replay episode arrays must have matching nonzero lengths")
+            if term.dtype != torch.bool or trunc.dtype != torch.bool or (term & trunc).any():
+                raise ValueError("Invalid replay terminal flags")
+            ends = term | trunc
+            if ends[:-1].any() or not ends[-1]:
+                raise ValueError("Replay expects complete individual episodes")
+            if not torch.allclose(torch.as_tensor(e["next_observation"][:-1]), torch.as_tensor(e["observation"][1:]), atol=1e-6, rtol=1e-6):
+                raise ValueError("Replay next observations cross a reset boundary")
+        self.lengths = [len(e["observation"]) for e in episodes]
+        self.offsets = np.cumsum([0] + self.lengths)
+        self.data = {k: torch.cat([torch.as_tensor(e[k]) for e in episodes]) for k in episodes[0]}
+        self.rng = np.random.default_rng(seed)
+
+    def sample_transitions(self, batch_size):
+        idx = self.rng.integers(0, self.offsets[-1], size=batch_size)
+        return {k: v[idx].clone() for k, v in self.data.items()}
+
+    def sample_states(self, batch_size):
+        # Same reference distribution rho as the FB in-batch next-state columns.
+        idx = self.rng.integers(0, self.offsets[-1], size=batch_size)
+        return self.data["next_observation"][idx].clone()
+
+    sample_goal_states = sample_states
+
+    def reference_states(self, count, seed):
+        rng = np.random.default_rng(seed)
+        idx = rng.choice(self.offsets[-1], min(count, self.offsets[-1]), replace=False)
+        return self.data["next_observation"][idx].clone(), idx.tolist()
+
+    def sample_sequences(self, batch_size, seq_len):
+        if seq_len < 1:
+            raise ValueError("seq_len must be positive")
+        starts = np.concatenate([np.arange(o, o + max(0, n - seq_len + 1)) for o, n in zip(self.offsets[:-1], self.lengths)])
+        if not len(starts):
+            raise ValueError("No episode long enough for requested sequence")
+        idx = self.rng.choice(starts, batch_size)[:, None] + np.arange(seq_len)[None, :]
+        return {k: v[idx].clone() for k, v in self.data.items()}
+
+    def state_dict(self):
+        return copy.deepcopy(self.rng.bit_generator.state)
+
+    def load_state_dict(self, state):
+        self.rng.bit_generator.state = copy.deepcopy(state)
