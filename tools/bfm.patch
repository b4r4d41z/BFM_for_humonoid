+
+
+@pytest.mark.parametrize('encoding,expected', [('rgb8',[1,2,3]),('bgr8',[3,2,1]),('rgba8',[1,2,3]),('bgra8',[3,2,1]),('mono8',[1,1,1])])
+def test_raw_decode_padding_channels_and_endianness(encoding, expected):
